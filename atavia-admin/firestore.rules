rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['info@ataviaweddings.com'];
    }
    match /bookings/{id} {
      allow read: if isAdmin();
      // Dashboard may only flip test_mode — nothing else on a booking is editable from the browser.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['test_mode'])
        && request.resource.data.test_mode is bool;
      // Delete only bookings already marked as test.
      allow delete: if isAdmin() && resource.data.test_mode == true;
      allow create: if false;
      // Gratuities (tips) are a subcollection; the dashboard reads them for earnings.
      match /gratuities/{g} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
