rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Verification documents: the user writes only to their own folder,
    // images or PDFs only, max 10MB. Reads: admin dashboard only — regular
    // clients never read. Files are deleted by the Admin SDK / decision
    // function after verification per the privacy promise. Client delete
    // is intentionally denied; a wrong upload is fixed by overwriting
    // (update is allowed).
    match /verification-docs/{uid}/{fileName} {
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 10 * 1024 * 1024
                            && (request.resource.contentType.matches('image/.*')
                                || request.resource.contentType == 'application/pdf');
      allow delete: if false;
      allow read: if request.auth != null
                  && (request.auth.token.admin == true
                      || request.auth.token.role == 'admin');
    }
    // Review photo evidence: publicly readable (they display on public
    // reviews), owner-only write into their own per-community folder,
    // images only, max 8MB. Owner may delete (removing photos when
    // editing a review).
    match /review-photos/{communityId}/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.size < 8 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Profile avatars: public read (they display on reviews), owner-only
    // write. Filename is locked to {uid}.jpg so users can't write into
    // each other's slots. Images only, max 5MB.
    match /profile-photos/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
                            && fileName == request.auth.uid + '.jpg'
                            && request.resource.size < 5 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName == request.auth.uid + '.jpg';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
